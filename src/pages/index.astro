---
//libraries import
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
//utils import
import { formatBlogPosts } from "../ts/utils";
//layouts import
import MainLayout from '../layouts/MainLayout.astro';
//component import
import QuickActions from '../components/pageParts/QuickActions.astro';
import PostCard from "../components/PostCard.astro"



const limit = 4;

const blogEntries = await getCollection("blog");

const formatedPosts = formatBlogPosts(blogEntries, {
	limit: limit,
});


function getTextBasedOnLimit(): string{
	if(limit == 1){
		return "Last post:"
	}
	else if(limit > formatedPosts.length){
		return `Last ${formatedPosts.length} posts:`;
	}
	else{
		return `Last ${limit} posts:`;
	}
}
---

<MainLayout title="Math Blog">
	<section class="relative mt-4 flex gap-[5%] lg:bg-[url('/images/tool.png')] lg:bg-cover lg:bg-center lg:aspect-[4/3] md:aspect-square">
		<div class="hidden lg:block black-cover"></div>
		<div class="flex flex-col justify-center lg:text-center lg:w-[80%] md:w-full mx-auto z-[1] lg:[container-type:size]">
			<h1 class="big-header">Math Blog</h1>
			<h2 class="big-header-subtext">Created by Shuniji and EventfulLynx915</h2>
		</div>
		<Image
			width={600}
			height={600}
			src="/images/tool.png"
			alt="main page cover"
			class="lg:hidden max-w-[45%] aspect-square object-cover object-top"
			loading="eager"
		/>
	</section>
	<QuickActions />
	<section class="mt-14 lg:mt-10 md:mt-8">
		<h3 class="h1 mb-5">{getTextBasedOnLimit()}</h3>
		<div class="scrollbar w-full pb-6 lg:pb-4 md:pb-2 flex flex-nowrap gap-10 lg:gap-4 md:gap-2 overflow-x-auto">
			{
				formatedPosts.map((post) => <PostCard post={post} />)
			}
		</div>
	</section>
</MainLayout>

<style>
	:root {
		--outline-color: black;
		--outline-size: 4px;
	}
	.outlined-text {
		//text-shadow:
		//	calc(-1 * var(--outline-size)) calc(-1 * var(--outline-size)) 0 var(--outline-color),
		//	0 calc(-1 * var(--outline-size)) 0 var(--outline-color),
		//	var(--outline-size) calc(-1 * var(--outline-size)) 0 var(--outline-color),
		//	var(--outline-size) 0 0 var(--outline-color),
		//	var(--outline-size) var(--outline-size) 0 var(--outline-color),
		//	0 var(--outline-size) 0 var(--outline-color),
		//	calc(-1 * var(--outline-size)) var(--outline-size) 0 var(--outline-color),
		//	calc(-1 * var(--outline-size)) 0 0 var(--outline-color);

		mix-blend-mode: difference;
	}
	.black-cover{
		position:absolute;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.3);
		background-image: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.8),
			rgba(0, 0, 0, 0) 60%,
			rgba(0, 0, 0, 0.8) 100%
	  );
	}
	.big-header{
		@apply text-[7.5rem] leading-tight text-text-primary-color font-daydream
		xl:[font-size:clamp(4rem,8vw+1rem,7.5rem)]
		lg:[font-size:20cqw]
		md:[font-size:16vw] md:leading-normal
	}
	.big-header-subtext{
		@apply text-[2.5rem] font-bold leading-none text-text-secondary-color mt-3
		xl:[font-size:clamp(1.5rem,1.5vw+1rem,2.5rem)]
		lg:[font-size:6cqw]
		md:[font-size:5vw]
	}
</style>