---
//lib import
import { getCollection } from "astro:content";
import type {CollectionEntry} from "astro:content"
//utils import
import { formatDate, getReadingTime } from "../../ts/utils.ts"
//layout import
import PostLayout from "../../layouts/PostLayout.astro";
import Icon from "../../components/Icon.astro";
import navData from "../../ts/navData";



export async function getStaticPaths(){
    const blogEntries = await getCollection("blog");

    return blogEntries.map(entry => ({
        params: {
            slug: entry.slug
        },
        props: {
            entry
        },
    }));
}
interface Props {
    entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props as Props;
const { title, author, image, date } = entry.data;
const readingTime = getReadingTime(entry.body);
const { Content } = await entry.render();

const getLinkByName = (name: string): string | undefined => {
    const navItem = navData.find(item => item.name == name);
    return navItem?.path;
};
const blogPath = getLinkByName("Blog");
---
<!--implement a better snap scroll-->
<PostLayout title={title}>

    <section class = "after-header" slot="after-header">
        <div
           class="link-image my-4"
           style={`background-image: url(${image.src});`}
        ></div>
        <section class="container py-3 px-8 lg:px-4 lg:py-0 md:px-2">
            <div class="title-nav-container">
                <h1 class="blog-title">{title}</h1>
                <div class="flex flex-col items-center justify-center md:hidden">
                    <a href = {blogPath}><Icon icon="arrow_up" class="arrow" width={35} height={35} fill="white"/></a>
                    <a href = "#content"><Icon icon="arrow_up" class="arrow" width={35} height={35} fill="white" transform="scale(1, -1)"/></a>
                </div>
            </div>
            <div class="other-info-box ">
                <h2>Written by: {author}</h2>
                <div class="flex items-center gap-4">
                    <Icon icon="clock" class="lg:w-6 lg:h-6" width={35} height={35} stroke="white"/>
                    <p>{readingTime}</p>
                </div>
                <p>{formatDate(date)}</p>
            </div>
        </section>
    </section>


    <section id="content" class="markdown-content">
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"
            integrity="sha384-MlJdn/WNKDGXveldHDdyRP1R4CTHr3FeuDNfhsLPYrq2t0UBkUdK2jyTnXPEK1NQ"
            crossorigin="anonymous"
        />
        <Content />
    </section>
</PostLayout>


<style>
    .title-nav-container{
        @apply w-full flex gap-8 justify-between items-center pt-8 pb-4
        lg:gap-6
        md:pb-2 md:pt-6
    }
    .after-header{
        @apply xl:px-[2rem] lg:px-[1rem];
    }
    .arrow{
        @apply w-20 h-20
        xl:w-14 xl:h-14
        lg:w-10 lg:h-10
    }
    .link-image{
        display: block;
        aspect-ratio: 16/10;
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
    }
    .blog-title{
        @apply text-[6rem] font-november leading-none hyphens-auto
        xl:text-[5rem]
        lg:text-[4rem]
        md:text-center md:text-[3.5rem]
    }
    .other-info-box{
        @apply pt-4 flex gap-x-12 items-center
        xl:flex-wrap xl:pb-4
        lg:text-lg lg:pt-2 lg:gap-x-8
        md:pt-0
    }
    h2{
        @apply pb-4 pt-2 text-2xl leading-none w-full
        lg:text-xl lg:pb-2;
    }
</style>