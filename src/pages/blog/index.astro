---
//lib import
import {getCollection} from "astro:content";
//utils import
import { getPinnedPost, formatBlogPosts } from '../../ts/utils'
//component import
import Icon from "../../components/Icon.astro";
import PostCard from "../../components/PostCard.astro";
import PostMiniCard from "../../components/PostMiniCard.astro"
import PostListCard from "../../components/PostListCard.astro"
import Search from '../../components/SearchWidget.astro';
//layout import
import MainLayout from '../../layouts/MainLayout.astro';
import QuickActions from "../../components/pageParts/QuickActions.astro";

const blogEntries = await getCollection("blog");
const pinnedPost = getPinnedPost(blogEntries);
const formatedPosts = formatBlogPosts(blogEntries,{
    filterOutPinned: true,
});


---
<MainLayout title="Whole Blog">
    <section class ="mt-12 flex gap-4 md:mt-6">
        {pinnedPost && (
        <div class="relative h-fit xl:hidden">
            <PostCard post={pinnedPost} />
            <Icon
                icon="push_pin"
                width={60}
                height={60}
                class="absolute top-[-40px] left-1/2 translate-x-[-95%]"
            />
        </div>
        )}
        <div class="xl:w-full">
            <Search />
        </div>
    </section>

    {pinnedPost && (
    <div class="hidden relative h-fit xl:block w-fit mx-auto mt-8 mb-2 lg:mt-4">
        <PostCard post={pinnedPost} />
        <Icon
            icon="push_pin"
            class="w-14 h-14 absolute top-[-35px] left-[42%] lg:w-10 lg:h-10 lg:top-[-20px]"
        />
    </div>
    )}


    <QuickActions />

    <section class="my-8 md:my-4">
        <div class="mb-8 lg:my-2 md:my-0 flex justify-between items-start gap-2">
            <h1 class="h1">Whole blog:</h1>
            <div>
                <button id="show-grid-posts"><Icon icon="grid" class="show-style-icon" width={45} height={45} stroke="white"/></button>
                <button id="show-line-posts"><Icon icon="list" class="show-style-icon" width={45} height={45} stroke="white"/></button>
            </div>
        </div>


        <section id="post-list-wrapper" class="hidden">
            {formatedPosts.map((post, index) => {
                return(
                        <PostListCard post={post} />
                )
            })}
        </section>



        <section id="post-grid-wrapper" class = "hidden">
            <div class="flex flex-wrap justify-between gap-y-4 lg:gap-y-2 md:gap-y-0">
                {formatedPosts.map((post) => (
                    <div class="post-item">
                        <PostMiniCard post={post} />
                    </div>
                ))}
            </div>
        </section>
    </section>
</MainLayout>

<style>
    .post-item{
        @apply max-w-[50%] lg:basis-full lg:max-w-full lg:my-1;

    }
    .show-style-icon{
        @apply xl:w-10 md:w-8
    }
</style>
<script>

   document.addEventListener("DOMContentLoaded", () => {
    const listButton = document.getElementById("show-line-posts") as HTMLButtonElement;
    const gridButton = document.getElementById("show-grid-posts") as HTMLButtonElement;
    const postListWrapper = document.getElementById("post-list-wrapper") as HTMLDivElement;
    const postGridWrapper = document.getElementById("post-grid-wrapper") as HTMLDivElement;

    postListWrapper.classList.add("hidden");
    postGridWrapper.classList.add("hidden");

    const preferredPostsView = localStorage.getItem("postsView") || "list";

    if (preferredPostsView === "grid") {
        postGridWrapper.classList.remove("hidden");
        gridButton.classList.add("hidden");
        listButton.classList.remove("hidden");
    } else {
        postListWrapper.classList.remove("hidden");
        listButton.classList.add("hidden");
        gridButton.classList.remove("hidden");
    }

    let listWrapperShown = (preferredPostsView === "list");

    listButton.addEventListener("click", showList);
    gridButton.addEventListener("click", showGrid);

    function showList() {
        if (!listWrapperShown) {
            postListWrapper.classList.remove("hidden");
            postGridWrapper.classList.add("hidden");

            listButton.classList.add("hidden");
            gridButton.classList.remove("hidden");

            localStorage.setItem("postsView", "list");
            listWrapperShown = true;
        }
    }

    function showGrid() {
        if (listWrapperShown) {
            postListWrapper.classList.add("hidden");
            postGridWrapper.classList.remove("hidden");

            listButton.classList.remove("hidden");
            gridButton.classList.add("hidden");

            localStorage.setItem("postsView", "grid");
            listWrapperShown = false;
        }
    }
});


</script>

