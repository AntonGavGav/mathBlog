---
//lib import
import { Image } from 'astro:assets';
//layouts import
import MainLayout from '../layouts/MainLayout.astro';
//data import
import creatorData from "../ts/creatorData"
//component import
import Link from "../components/Link.astro";
import QuickActions from "../components/pageParts/QuickActions.astro";
//pageParts
import CreatorLinks from "../components/pageParts/CreatorLinks.astro";


const shuniji = creatorData["Shuniji"];
const eventfullynx = creatorData["EventfulLynx915"];
---

<MainLayout title="About Creators">

    <section class="mt-12 lg:mt-8 md:mt-5 container w-full pb-10 lg:pb-5 md:pb-3" id="gamified-list-container">
        <header
            class="w-full h-10 md:h-6 chessboard-bg bg-[length:20px_20px] md:bg-[length:12px_12px]"
        ></header>
        <h1 class="main-text">ABOUT US</h1>
        <ul id="gamified-list" class="px-8 [&>li]:mb-2 md:px-4">
            <li >some text about us that can be pretty long so we gotta do it carefully cause who knows how long it will be and that is what i be testing right at the moment so I can be sure</li>
            <li>in my professional opinion it looks pretty decent and I would keep it that way</li>
            <li >third part about something small I guess</li>
            <li>We gotta keep a big amount of this parts cause I like the way it looks</li>
            <li >Big amount of text, we can come up with something for sure to write here</li>
            <li >And maybe one more for just some styling</li>
        </ul>
    </section>




    <section id= "scrollContainer" class="flex justify-between mt-5 lg:flex-nowrap lg:overflow-x-auto lg:gap-4 lg:snap-x lg:snap-mandatory" >

        <!--Shuniji-->
        <article class="container">
            <div class="creator-presentation-container">
                <div class="xl:hidden h-[330px] w-[4.5rem] overflow-hidden">
                    <h2 class = "shuniji_name">{shuniji.name.toUpperCase()}</h2>
                </div>
                <Image
                        src={shuniji.imagePath}
                        width={330}
                        height={330}
                        class = "creator-presentation-image"
                        alt = "Shuniji pic"
                />
                <h3 class = "hidden xl:block absolute text-[14vw] mt-4 lg:text-[16vw] lg:mt-2 leading-none font-november text-center">
                    SHUN<br />IJI
                </h3>
            </div>
            <p class="description">{shuniji.description}</p>
            <CreatorLinks
                githubUrl = {shuniji.urls.github}
                instagramUrl = {shuniji.urls.instagram}
                twitterUrl = {shuniji.urls.twitter}
            />
        </article>

        <!--EventfulLynx915-->
        <article class="container">
            <div class="creator-presentation-container">
                <Image
                        src={eventfullynx.imagePath}
                        width={330}
                        height={330}
                        class = "creator-presentation-image"
                        alt = "EventfulLynx pic"
                />
                <h3 class = "hidden xl:block absolute text-[10vw] lg:text-[11vw] mt-4 lg:mt-2 leading-none font-november text-center">
                    EVENT<br />FULLY<br>NX915
                </h3>
                <div class="xl:hidden h-[330px] w-[4.5rem] overflow-hidden">
                    <h2
                        class = "scrollable-text"
                    >{eventfullynx.name.toUpperCase()} </h2>
                    <h2
                            class="scrollable-text mt-[-6px]"
                    >{eventfullynx.name.toUpperCase()}</h2>
                </div>
            </div>
            <p class="description">{eventfullynx.description}</p>
            <CreatorLinks
                githubUrl = {eventfullynx.urls.github}
                instagramUrl = {eventfullynx.urls.instagram}
                twitterUrl = {eventfullynx.urls.twitter}
            />
        </article>
    </section>
    <div class = "hidden lg:flex w-full item-center mt-5 justify-center gap-6">
        <div id="dot1" class = "dot"></div>
        <div id ="dot2" class = "dot"></div>
    </div>
    <QuickActions />
</MainLayout>




<style>
    .main-text{
        @apply font-november text-center mt-12 pb-12 text-7xl
        lg:mt-8 lg:pb-8
        md:text-[2.5rem] md:mt-6 md:pb-4
    }

    .bg-size-20by20{
        background-size: 20px 20px;
    }
    .bg-size-15by15{
        background-size: 15px 15px;
    }

    article{
        @apply w-[49%] relative pb-24
        xl:pb-16
        lg:flex-none lg:w-[70vw]
        snap-center
        md:pb-12
    }
    .creator-presentation-container{
        @apply flex justify-between items-center pt-12 px-10 relative
        xl:justify-center
        md:px-4 md:pt-3
    }
    .creator-presentation-image{
        @apply w-[330px] h-[330px]
        xl:w-full xl:h-full xl:p-1
    }
    .shuniji_name{
        transform: scale(-1);
        writing-mode: vertical-lr;
    }

    h2{
        height: fit-content;
        font-size: 5.2rem;
        line-height: 1;
    }

    .dot{
        @apply w-[10px] h-[10px] bg-light-accent
    }

    .description{
        @apply pl-10 pr-28 pt-6 pb-4
        xl:px-8
        md:px-4 md:pb-1 md:pt-2
    }

    .scrollable-text{
        display:inline-block;
        writing-mode: vertical-rl;
        animation: vertical-scroll 10s infinite linear normal;
    }

    @keyframes vertical-scroll {
        0% {
            transform: translate(0, 0);
        }
        100% {
            transform: translate(0, -100%);
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const scrollContainer = document.getElementById("scrollContainer");
        const dot1 = document.getElementById("dot1");
        const dot2 = document.getElementById("dot2");

        let currentSElementVisible = 1;

        dot2.classList.add('opacity-50');

        function handleScroll(){
            const scrollLeft  = scrollContainer.scrollLeft;
            const containerWidth = scrollContainer.offsetWidth;

            if(scrollLeft < containerWidth/3  && currentSElementVisible == 2){
                dot1.classList.remove('opacity-50');
                dot2.classList.add('opacity-50');
                currentSElementVisible = 1;
            }
            else if(scrollLeft > containerWidth/3  && currentSElementVisible == 1){
                dot1.classList.add('opacity-50');
                dot2.classList.remove('opacity-50');
                currentSElementVisible = 2;
            }
        }

        scrollContainer.addEventListener('scroll', handleScroll);


        const listContainer = document.getElementById('gamified-list-container');
        const list = document.getElementById('gamified-list');
        const items = Array.from(list.children);
        let selectedIndex = 0;
        let isMouseOver = false;

        const updateSelection = () => {
            items.forEach((item, index) => {
                item.textContent = (index === selectedIndex ? '> ' : '- ') + item.textContent.replace(/^[-> ]/, '');
            });
        };

        const handleKeyDown = (event) => {
            if (isMouseOver) {
                event.preventDefault(); // Prevent default scrolling behavior
                if (event.key === 'ArrowDown') {
                    selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
                    updateSelection();
                } else if (event.key === 'ArrowUp') {
                    selectedIndex = Math.max(selectedIndex - 1, 0);
                    updateSelection();
                }
            }
        };

        updateSelection();

        listContainer.addEventListener('mouseenter', () => {
            isMouseOver = true;
        });

        listContainer.addEventListener('mouseleave', () => {
            isMouseOver = false;
        });

        document.addEventListener('keydown', handleKeyDown);
    });
</script>