---
import { Astronav, MenuItems, MenuIcon, Dropdown, DropdownItems, DropdownSubmenu } from "astro-navbar";
import navData from "../../ts/navData";
import Link from "../Link.astro";
import Icon from "../Icon.astro";

const attributes = { width: "60", height: "60"};
---
<nav>
    <Astronav id="astro-nav" closeOnClick class="z-10">
        <div class="relative min-w-full flex justify-between items-center p-3 container">
            <a href = "/">
                <Icon icon="logo" isInverted={true} {...attributes} />
            </a>
            <div class="flex gap-2 order-1 lg:hidden">
            {navData.map((item) => (
                <Link
                    href={item.path}
                    text={item.name}
                />
            ))}
            </div>

            <MenuItems class="hidden absolute z-10 right-[-3px] top-[100%] bg-dark-accent border-r-def-width border-b-def-width border-light-accent">
                <ul>
                 {navData.map((item) => (
                    <li>
                        - <a href={item.path}>{item.name}</a>
                    </li>
                ))}
                </ul>
            </MenuItems>
            <MenuIcon class="order-3 hidden lg:block"/>
        </div>
    </Astronav>
</nav>

<script>
document.addEventListener("DOMContentLoaded", function () {
  function handleResize() {
      closeMenu();
  }
  window.addEventListener("resize", handleResize);
});


function closeMenu() {
    const navMenuItems = document.querySelector(".astronav-items");
    if (! navMenuItems.classList.contains("hidden")) {
        const navToggle = document.getElementById("astronav-menu");

        const MenuIcons = navToggle.querySelectorAll(".astronav-toggle");

        navMenuItems?.classList.add("hidden");
        MenuIcons.forEach((el) => {
            el.classList.toggle("hidden");
        });
    }

}

</script>