---
//components import
import Icon from "./Icon.astro";
---


<template id="listItemTemplate">
    <tr>
        <td>
            <div class="bg-dark-accent my-2 lg:my-0 p-3">
                <a class="inline-block text-4xl my-4 lg:my-2 md:text-2xl md:my-1" id="title"></a>
                <div class="flex w-2/3 items-center justify-between md:w-full">
                    <p id="author"></p>
                    <p id="date"></p>
                    <p id="time"></p>
                </div>
            </div>
        </td>
    </tr>
</template>

<template id="caption">
    <caption class="text-3xl mt-36 xl:hidden">Search <br />something</caption>
</template>

<template id="loaderTemplate">
    <div id="loader-parent">
        <div id="loader"></div>
    </div>
</template>





<aside class="flex flex-col relative">

    <div
        id="blurBg"
        class="hidden fixed inset-0 backdrop-blur z-20"
    ></div>

    <div class="search-bar">
        <div class="absolute inset-y-0 start-3 flex items-center ps-3 pointer-events-none lg:ps-2 md:ps-0.5 md:start-2">
            <Icon
                icon="search"
                width={37}
                height={37}
                class="lg:w-9 md:w-5"
                stroke="white"
            />
        </div>
        <label for="search"></label>
        <input
            type="text"
            required
            minlength="3"
            maxlength="30"
            placeholder="Search smth..."
            class="search-input"
            id="search"
            autocomplete="off"
        />
        <button
            id="clearSearch"
            class = "absolute inset-y-0 end-3 flex items-center pe-3 md:pe-0.5"
            type="button"
            style="visibility: hidden;"
        >
            <Icon
                icon="cross"
                width="34"
                height="34"
                class="md:w-6"
                stroke="white"
            />
        </button>
    </div>


    <div id = "searchContainer" class="result-container scrollbar">
        <div class="relative w-[98%]" dir="ltr">
            <p id="searchReadout"></p>
            <table id="searchResultList">

            </table>
        </div>
    </div>
</aside>

<style>
    @import '../styles/loader.css';
    #loader-parent{
        position:relative;
        width:55px;
        height:55px;
    }
    #loader{
        position: absolute;
        width: 10px;
        height: 10px;
        left: 50%;
        top: 50%;
        transform:scale(0.8) translate(-50%, -50%);
    }
    #clearSearch {
        cursor: pointer;
    }

    .result-container{
        @apply h-[22.9rem] overflow-y-auto pointer-events-none
        xl:z-30 xl:absolute xl:w-full xl:mt-20 xl:h-[32rem]
        md:h-[20rem];
        direction: rtl;
    }
     table{
        position: absolute;
        width: 100%;
    }
    p{
        @apply text-sm
    }

    table tr{
        @apply border-b-def-width border-light-accent
    }
    table tr:last-child {
        @apply border-b-0;
    }

    .search-bar{
        @apply relative w-full mb-4 flex items-center z-30
    }
    .search-input{
        @apply block w-full text-4xl font-normal h-full p-4 ps-20 bg-dark-accent border-def-width
        focus:border-light-accent focus:rounded-none
        lg:text-2xl
        md:p-2 md:ps-10 md:text-xl
    }
</style>

<script>
    //lib import
    import DOMPurify from "dompurify";
    import Fuse from "fuse.js";


    type Post = {
        slug: string;
        title: string;
        author: string;
        date: string;
        readTime: string;
    };


    let SEARCH_DATA: Post[] | undefined;
    let FUSE_INSTANCE: Fuse<Post> | undefined;
    const FUSE_OPTIONS = {
        includeScore: true,
        shouldSort: true,
        threshold: .5,
        keys: [
            {
                name: "title",
                weight: 0.9,
            }
        ],
    }

    //templates
    const loaderTemplate = document.getElementById("loaderTemplate") as HTMLTemplateElement;
    const loaderTemplateContent = loaderTemplate.content;

    const listItemTemplate = document.getElementById("listItemTemplate") as HTMLTemplateElement;
    const listItemTemplateContent = listItemTemplate.content;

    const searchCaptionTemplate = document.getElementById("caption") as HTMLTemplateElement;
    const searchCaptionTemplateContent = searchCaptionTemplate.content;

    //search related
    const searchContainer = document.getElementById("searchContainer") as HTMLDivElement;
    const search = document.getElementById("search") as HTMLInputElement;
    const searchReadout = document.getElementById("searchReadout") as HTMLElement;
    const searchResultList = document.getElementById("searchResultList") as HTMLElement;

    const blurBg = document.getElementById("blurBg") as HTMLElement | null;
    const clearSearchButton = document.getElementById("clearSearch") as HTMLElement | null;

    showCaption();

    //functions
    export function formatDate(date:string): string{
        return new Date(date).toLocaleDateString('en-US', {timeZone: "UTC",});
    }

    function updateSearchReadout(searchTerm: string):void{
        searchReadout.textContent = searchTerm
        ? `Search results for "${searchTerm}"`
        : "";
    }
    function runSpinner():void{
        const loaderTemplateClone = loaderTemplateContent.cloneNode(true) as HTMLElement;
        searchResultList.innerHTML = '';
        searchResultList.appendChild(loaderTemplateClone);
    }
    function createListItem(title, author, date, readTime, slug): DocumentFragment{
        const template = listItemTemplateContent.cloneNode(true) as DocumentFragment;

        const linkElement = template.querySelector("a");
        linkElement.setAttribute("href", `/blog/${slug}`);
        linkElement.textContent = title;

        const authorElement = template.getElementById("author");
        authorElement.textContent = author;

        const dateElement = template.getElementById("date");
        dateElement.textContent = date;

        const readingTimeElement = template.getElementById("time");
        readingTimeElement.textContent = readTime;

        return template;
    }

    function showCaption():void{
        searchResultList.innerHTML = "";
        searchResultList.appendChild(searchCaptionTemplateContent.cloneNode(true) as HTMLElement);
    }

    function fillOutResultList(results):void{
        if(results.length == 0){
            searchContainer.style.pointerEvents ="none";
            searchResultList.innerHTML = "No results found...";
            return;
        }
        searchContainer.style.pointerEvents = "auto";
        searchResultList.innerHTML = "";
        const fragment = document.createDocumentFragment();
        results.map((result) => {
            const { title, author, date, readTime, slug } = result.item;
            const formattedDate = formatDate(date);
            const listItem = createListItem(title, author, formattedDate, readTime, slug);
            fragment.appendChild(listItem);
        });
        searchResultList.appendChild(fragment);
    }

    async function fetchSearchResults(term: string): Promise<void>{
        if(term.length === 0){
            showCaption();
            return;
        }
        runSpinner();
        if(!SEARCH_DATA){
            try{
                const res = await fetch("/endpoints/search_data.json")
                if(!res.ok){
                    throw new Error("fetched res is not ok");
                }
                SEARCH_DATA = await res.json();
            }
            catch(e){
                console.error(e);
            }
        }
        //creating a Fuse instance
        if(SEARCH_DATA && !FUSE_INSTANCE){
            FUSE_INSTANCE = new Fuse(SEARCH_DATA, FUSE_OPTIONS);
        }

        const searchResult = FUSE_INSTANCE?.search(term) || [];
        fillOutResultList(searchResult);
    }

    function clearSearch(): void {
        search.value = "";
        updateSearchReadout("");
        showCaption();
        hideBlurBg();
        clearSearchButton.style.visibility = "hidden";
    }
    function toggleClearButton(): void {
        if (clearSearchButton) {
            clearSearchButton.style.visibility = search.value ? "visible" : "hidden";
        }
    }
    function showBlurBg(): void{
        if(blurBg && window.matchMedia("(max-width: 1130px)").matches){
            blurBg.classList.remove("hidden");
        }
    }
    function hideBlurBg():void{
        if (blurBg) blurBg.classList.add("hidden");
    }


    //event listeners
    search.addEventListener("input", ():void => {
        const searchTerm:string = DOMPurify.sanitize(search.value);
        updateSearchReadout(searchTerm);
        fetchSearchResults(searchTerm);
        toggleClearButton();
    });
    search.addEventListener("focus", showBlurBg);
    if (clearSearchButton) {
        clearSearchButton.addEventListener("click", clearSearch);
    }
    if (blurBg) {
        blurBg.addEventListener("click", clearSearch);
    }
    document.addEventListener("keydown", (event) => {
       if (event.key === "Escape" && blurBg && !blurBg.classList.contains("hidden")){
            clearSearch();
            search.blur();
       }
    });
</script>