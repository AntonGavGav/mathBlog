---
import type { CollectionEntry } from "astro:content";
//utils import
import { formatDate, getReadingTime } from "../ts/utils.ts"


interface Props {
    post: CollectionEntry<'blog'>;
}

const { post } = Astro.props as Props;

const url = `/blog/${post.slug}`;
const { title, author, date, image } = post.data;

const readingTime = getReadingTime(post.body);
---

<article>
    <a href={url} class="flex items-center h-full relative">
        <div
            class="link-image"
            style={`background-image: url(${image.src});`}
        ></div>
        <div class="text-container">
            <div class="flex gap-4 items-center">
                <p class="xl:hidden">{formatDate(date)}</p>
                <p>{readingTime}</p>
            </div>
            <h2 class="blog-title">
                {title}
            </h2>
            <p>{author}</p>
        </div>
    </a>
</article>




<style>
    .link-image{
        @apply relative aspect-[16/12] bg-no-repeat bg-cover bg-center flex-shrink-0 w-[15rem]
        xl:w-[11rem]
        md:w-[8rem]
    }
    .text-container{
        @apply flex-1 self-stretch flex flex-col justify-around pl-4;
    }
    .blog-title{
        @apply text-4xl leading-none max-w-full line-clamp-3 xl:line-clamp-2
        lg:text-2xl
    }
    p{
        @apply md:text-sm
    }
</style>